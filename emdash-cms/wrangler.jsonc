{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-portfolio-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"account_id": "ea828ee3d305326b20685452988466e4",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emdash-portfolio-db",
			"database_id": "58eeaf0d-5e79-47b2-8a06-27a0155d27ff",
		},
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "cd1080ce8af74c9cb56f1b270b51c57f",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-portfolio-media",
		},
	]
}
