# GEMINI_API_KEY: API key for Gemini AI.
GEMINI_API_KEY=
ELEVEN_LABS_API_KEY=

# SePay Payment Integration
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_ACCOUNT_ID=

# APP_URL: Public app URL if needed.
APP_URL="MY_APP_URL"

# API_PORT: Local API server port.
API_PORT="8787"

# HOST_PORT: Host port to map into container (avoid conflict with existing :80 services).
HOST_PORT="8081"

# TELEGRAM_BOT_TOKEN: Bot token for admin notifications.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: Chat id to receive new leads.
TELEGRAM_CHAT_ID=""

# ZALO_WEBHOOK_URL: Optional relay webhook for forwarding lead data to Zalo OA, n8n, Make, or your own backend.
ZALO_WEBHOOK_URL=""

# ADMIN_WEBHOOK_URL: Legacy optional webhook.
ADMIN_WEBHOOK_URL=""
